* text=auto

# Keep this file itself LF so the rules above stay byte-identical everywhere.
.gitattributes text eol=lf

# Anything that runs on the device must keep LF. A CRLF shebang
# ("#!/bin/sh\r") makes the kernel look for /bin/sh\r and fails with
# "not found" -- this bit us before when transferring over the serial console.
*.sh      text eol=lf
*.service text eol=lf
*.mount   text eol=lf
*.conf    text eol=lf
*.log     text eol=lf
*.md      text eol=lf

# Files whose sha512 goes into an APKBUILD. If these are checked out with CRLF
# the checksum no longer matches and abuild refuses to build.
APKBUILD  text eol=lf
deviceinfo text eol=lf
*.patch   text eol=lf
*.dts     text eol=lf
*.dtsi    text eol=lf

# Read back by gen-kernel-dts-patch.py to build a diff against a kernel tree
# that is LF. CRLF here would produce a patch that does not apply.
tools/dtb/qcom-dts-Makefile.* text eol=lf

# This one ships inside the flashing zip and is meant to be double-clicked by
# Windows users. CRLF so it opens correctly in older Notepad.
tools/edl/readme.txt text eol=crlf

# Windows-only artefacts.
*.ps1     text eol=crlf
*.bat     text eol=crlf
