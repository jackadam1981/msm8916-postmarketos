# Local firmware and extraction products
firmware/*
!firmware/.gitkeep
out/*
!out/.gitkeep

# External source checkouts
third_party/lk2nd/
third_party/pmaports/
third_party/pmbootstrap/
third_party/linux/

# Local tool downloads
.local-tools/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Temporary files and generated binaries
.bifrost-headers.txt
.codex-mcp-debug/
log.txt
*.tmp
*.log
# 真机 bring-up 证据日志需要入库（覆盖上面的 *.log 规则）
!docs/bringup/**/*.log
*.img
*.bin
*.dtb
*.dtbo
*.dts.tmp
# 原厂固件里提取的 DTB 是证据文件，不是编译产物，必须入库
!docs/bringup/**/vendor-*.dtb
# 刷机包要发的分区表也是构建输入，不是产物：CI 会把它们拷进 zip，
# 缺了这两个文件 pmos-build 的打包步骤会直接 cp 失败
!config/gpt/*.bin
