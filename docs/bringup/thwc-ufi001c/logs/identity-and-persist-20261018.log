5. 服务重启（走完整 systemd 路径）
================================================================

$ systemd-run --on-active=3 --unit=usb-lan-restart --collect \
      systemctl restart usb-lan.service

# 重启后:
$ systemctl is-active usb-lan.service
active                                  # 之前是 inactive（手动 up 的残留状态）

$ findmnt -no TARGET,SOURCE,FSTYPE,OPTIONS /persist
/persist /dev/mmcblk0p11 ext4 ro,relatime

$ systemctl show persist.mount -p FragmentPath -p WantedBy
FragmentPath=/usr/lib/systemd/system/persist.mount
WantedBy=local-fs.target

$ systemctl is-enabled persist.mount
enabled

$ systemctl list-dependencies local-fs.target | grep persist
● ├─persist.mount

$ ls -l /dev/disk/by-partlabel/persist
lrwxrwxrwx ... /dev/disk/by-partlabel/persist -> ../../mmcblk0p11

$ ping -c 2 -W 3 223.5.5.5
2 packets transmitted, 2 received, 0% packet loss
round-trip min/avg/max = 33.665/37.636/41.607 ms


