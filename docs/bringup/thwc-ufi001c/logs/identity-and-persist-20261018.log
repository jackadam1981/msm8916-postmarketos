# persist 挂载 + MAC 序列号派生 —— 原始证据
# 设备: 410stick-ufi003-mb-v02 (UFI003-02, MSM8916)
# 内核: 6.12.1-msm8916, postmarketOS edge
# 采集: 2026-10-18 21:26-21:32 (设备本地时间), 经 LAN SSH (192.168.100.1)

================================================================
1. 改之前的状态
================================================================

$ cat /etc/fstab
# <file system> <mount point> <type> <options> <dump> <pass>
UUID=3d35c1c5-f899-4a5e-bc6a-f182474361cc / ext4 defaults 0 0

$ findmnt /persist
(empty)  # 根本没挂载

$ blkid | grep -i persist
/dev/mmcblk0p11: UUID="57f8f4bc-abf4-655f-bf67-946fc0f9f25b" BLOCK_SIZE="4096"
                  TYPE="ext4" PARTLABEL="persist" PARTUUID="e98d2f84-..."

$ cat /sys/firmware/devicetree/base/serial-number
26e041bc

$ cat /sys/class/net/wlan0/address
02:00:26:e0:41:bc      # = 02:00 + serial, 内核派生

$ cat /sys/class/net/usb0/address
02:00:26:e0:41:be      # = 02:00 + serial + 2, 原脚本硬编码

$ cat /proc/device-tree/model
UFI003_MB_V02 4G Modem Stick


================================================================
2. persist 内容（只读挂载后）
================================================================

$ sudo mount -o ro /dev/mmcblk0p11 /persist
$ sudo ls -la /persist/
total 52
drwxrwx--x    4 1000     1000          4096 Jan  1  1970 .
-rw-------    1 1002     1002             9 Jan  1  1970 .bt_nv.bin
-rw-r--r--    1 1010     1010         29816 Nov  1  2022 WCNSS_qcom_wlan_nv.bin
drwxr-xr-x    2 root     root          4096 Nov  1  2022 aost
drwx------    2 root     root          4096 Jan  1  1970 lost+found

$ md5sum /persist/WCNSS_qcom_wlan_nv.bin
4c3bfa34...   (29816 bytes, 时间戳 2022-11-01 = 原厂固件构建日)

# 在 nv.bin / modemst1 / modemst2 / fsg 中搜索清单记录的原厂 MAC
# 5c:a0:00:73:6d:11 -> 搜 '5ca0' 和 '736d11'
$ grep -c ... /persist/WCNSS_qcom_wlan_nv.bin   -> 0
$ modemst1 (2MB)  -> not found
$ modemst2 (2MB)  -> not found
$ fsg      (2MB)  -> not found

# 结论: 这族 persist 里没有个体化 MAC。
#        nv.bin 是通用校准模板（无 5ca0 OUI），.bt_nv.bin 的 BD_ADDR
#        e4:a8:10:00:00:08 尾部像默认值。


================================================================
3. MAC 派生单测（本地, 三台清单机器的序列号）
================================================================

serial     -> dev_addr             host_addr
26e041bc   -> 02:00:26:e0:41:be    02:00:26:e0:41:bf
1db15d2a   -> 02:00:1d:b1:5d:2c    02:00:1d:b1:5d:2d
216ffcc1   -> 02:00:21:6f:fc:c3    02:00:21:6f:fc:c4
fffffffe   -> 02:00:00:00:00:00    02:00:00:00:00:01   (进位正确)
00000001   -> 02:00:00:00:00:03    02:00:00:00:00:04

# 7 位序列号 1db15d2 左补零到 01db15d2 后:
01db15d2   -> 02:00:01:db:15:d4    02:00:01:db:15:d5


