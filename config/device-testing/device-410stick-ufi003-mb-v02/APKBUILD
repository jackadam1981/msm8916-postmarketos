# Device package for 410stick UFI003-02 (MSM8916) -- local overlay
# Reference: <https://postmarketos.org/devicepkg>
#
# The device tree is NOT shipped here anymore.  It is built from
# msm8916-zhihe-ufi003-mb-v02.dts by the kernel package overlay in
# config/kernel-testing/linux-postmarketos-qcom-msm8916/ and installed to
# /boot/dtbs/qcom/, which is the first path boot-deploy looks at.
#
# The old prebuilt binary is still in git history if it is ever needed:
#   git show f55e421:config/device-testing/device-410stick-ufi003-mb-v02/msm8916-zhihe-ufi003-mb-v02.dtb
pkgname=device-410stick-ufi003-mb-v02
pkgdesc="Device package for 410stick UFI003-02 LTE dongle (MSM8916)"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="GPL-2.0-only"
arch="aarch64"
options="!check !archcheck"
depends="
	mkbootimg
	postmarketos-base
	soc-qcom-msm8916
	linux-postmarketos-qcom-msm8916
	soc-qcom-msm8916-rproc
"
_pmb_select="soc-qcom-msm8916-rproc"
makedepends="devicepkg-dev"
source="deviceinfo"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

sha512sums="
